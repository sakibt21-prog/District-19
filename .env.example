# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Full database access: keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
